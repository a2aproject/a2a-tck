      "requirement": "CARD-SIGN-001",
      "agent_card": {
        "name": "Example Agent",
        "description": "",
        "capabilities": {
          "streaming": false,
          "pushNotifications": false
        },
        "skills": []
      },
      "alg": "EdDSA",
      "kid": "key-1",
      "protected_header": {
        "alg": "EdDSA",
        "typ": "JOSE",
        "kid": "key-1"
