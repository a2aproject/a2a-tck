      "expected_protected_b64": "eyJhbGciOiJFZERTQSIsImtpZCI6ImtleS0xIiwidHlwIjoiSk9TRSJ9",
      "expected_jcs_payload": "{\"capabilities\":{\"pushNotifications\":false,\"streaming\":false},\"description\":\"\",\"name\":\"Example Agent\",\"skills\":[]}",
      "expected_signing_input": "eyJhbGciOiJFZERTQSIsImtpZCI6ImtleS0xIiwidHlwIjoiSk9TRSJ9.eyJjYXBhYmlsaXRpZXMiOnsicHVzaE5vdGlmaWNhdGlvbnMiOmZhbHNlLCJzdHJlYW1pbmciOmZhbHNlfSwiZGVzY3JpcHRpb24iOiIiLCJuYW1lIjoiRXhhbXBsZSBBZ2VudCIsInNraWxscyI6W119",
      "signature": "olG34aQUzhOSXDUMp3m6zcOwX0zuPSH2wbcx3uY5d4CxjHTJNk_esMFDC379Tv780LltfYD9EZ9HDmKUKSe0BQ",
      "note": "Full JWS signing of the minimal card: canonical payload -> protected header -> signing input -> EdDSA signature. EdDSA chosen so the signature is byte-reproducible."
    },
    {
      "id": "cardsign-sign-002",
      "requirement": "CARD-SIGN-001",
      "agent_card": {
        "name": "Pay Agent",
        "version": "1.0.0",
        "url": "https://pay.example/a2a",
        "capabilities": {
          "streaming": true
        },
        "securitySchemes": {
          "oauth": {
            "type": "oauth2"
          }
        },
        "skills": [
          {
            "id": "quote",
            "name": "Quote"
          }
        ]
      },
      "alg": "EdDSA",
      "kid": "key-1",
      "protected_header": {
        "alg": "EdDSA",
        "typ": "JOSE",
        "kid": "key-1"
      },
      "expected_protected_b64": "eyJhbGciOiJFZERTQSIsImtpZCI6ImtleS0xIiwidHlwIjoiSk9TRSJ9",
      "expected_jcs_payload": "{\"capabilities\":{\"streaming\":true},\"name\":\"Pay Agent\",\"securitySchemes\":{\"oauth\":{\"type\":\"oauth2\"}},\"skills\":[{\"id\":\"quote\",\"name\":\"Quote\"}],\"url\":\"https://pay.example/a2a\",\"version\":\"1.0.0\"}",
      "expected_signing_input": "eyJhbGciOiJFZERTQSIsImtpZCI6ImtleS0xIiwidHlwIjoiSk9TRSJ9.eyJjYXBhYmlsaXRpZXMiOnsic3RyZWFtaW5nIjp0cnVlfSwibmFtZSI6IlBheSBBZ2VudCIsInNlY3VyaXR5U2NoZW1lcyI6eyJvYXV0aCI6eyJ0eXBlIjoib2F1dGgyIn19LCJza2lsbHMiOlt7ImlkIjoicXVvdGUiLCJuYW1lIjoiUXVvdGUifV0sInVybCI6Imh0dHBzOi8vcGF5LmV4YW1wbGUvYTJhIiwidmVyc2lvbiI6IjEuMC4wIn0",
      "signature": "Hwm5j4jzkRaIYuDIMAGfkpOw0kcp6VT5i2ziXy-d-Yz-jj97tPqrMqNkndWxvpUP4W8U7qMQViIQR1lDL5c5Cw",
      "note": "Signing generalises to a richer card."
    }
  ]
}
